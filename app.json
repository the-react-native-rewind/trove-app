{
  "expo": {
    "name": "Trove",
    "slug": "trove",
    "owner": "the-react-native-rewind",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "trove",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.rewind.trove",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "Trove uses your photos to add images and videos to a task."
      }
    },
    "android": {
      "package": "com.rewind.trove",
      "adaptiveIcon": {
        "backgroundColor": "#F2EAD9",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "ios": {
            "buildReactNativeFromSource": true
          }
        }
      ],
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F2EAD9",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120,
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 100
          }
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-video",
      [
        "expo-image-picker",
        {
          "photosPermission": "Trove uses your photos to add images and videos to a task."
        }
      ],
      "expo-build-properties",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Trove uses the microphone so you can dictate a task.",
          "speechRecognitionPermission": "Trove turns your speech into the task description."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8396f5b4-3415-42a5-a683-7bdb52ca7aec"
      }
    }
  }
}
