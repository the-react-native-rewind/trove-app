{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/assets/*": [
        "./assets/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "supabase/functions/mcp",
    "supabase/functions/delete-account",
    "supabase/functions/enrich-task",
    "supabase/functions/send-email",
    "supabase/functions/open",
    "supabase/functions/_shared/emailCopy.ts",
    "supabase/templates"
  ]
}
