EXPO_PUBLIC_SUPABASE_URL=your-project-url
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key
# Optional. Shown under Account → Connect an AI assistant. Defaults to
# <EXPO_PUBLIC_SUPABASE_URL>/functions/v1/mcp. Set this when the public MCP
# host is a Trove domain, for example https://mcp.example.com
EXPO_PUBLIC_MCP_RESOURCE_URL=
